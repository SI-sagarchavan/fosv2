{
  "name": "fanos",
  "version": "0.0.0",
  "private": true,
  "description": "FanOS monorepo — Figma-to-SDUI generation pipeline",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "dev:studio": "pnpm --filter @fanos/surface-studio dev",
    "dev:web": "pnpm --filter @fanos/web dev",
    "dev:api": "pnpm --filter @fanos/api dev",
    "dev:worker": "pnpm --filter @fanos/api dev:worker"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
