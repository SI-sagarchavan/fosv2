{
  "name": "@fanos/surface-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Surface Studio \u2014 the page board. Listens for sends from the Figma plugin.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3000 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "test": "node -e \"process.exit(0)\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@electric-sql/react": "^1.0.55",
    "@fanos/compile": "workspace:*",
    "@fanos/dsl": "workspace:*",
    "@fanos/renderer": "workspace:*",
    "@fanos/surface-canvas": "workspace:*",
    "@fanos/tokens": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
