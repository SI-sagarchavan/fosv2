{
  "name": "@fanos/api",
  "version": "0.1.0",
  "private": true,
  "description": "FanOS control plane: artifact store, surface versioning, pipeline runs and the fidelity gate",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "dev": "node --env-file=.env --watch dist/index.js",
    "dev:worker": "node --env-file=.env --watch dist/worker.js",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env dist/platform/db/migrate.js",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fanos/compile": "workspace:*",
    "@fanos/conform": "workspace:*",
    "@fanos/dsl": "workspace:*",
    "@fanos/renderer": "workspace:*",
    "@fanos/surface-canvas": "workspace:*",
    "@fanos/tokens": "workspace:*",
    "bullmq": "^5.34.6",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "postgres": "^3.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "drizzle-kit": "^0.30.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
