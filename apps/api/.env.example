NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# 5433, not 5432 — see the port note in docker-compose.yml.
DATABASE_URL=postgres://fanos:fanos@localhost:5433/fanos
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

BLOB_DRIVER=fs
BLOB_ROOT=./.blobs

# Comma-separated. Leave empty in development to disable auth; required in production.
API_KEYS=

WORKER_CONCURRENCY=4
RUN_MAX_ATTEMPTS=3

# Electric sync engine. Never exposed to browsers — apps/api proxies it.
ELECTRIC_URL=http://localhost:3010

# Browser origins allowed to call this API (apps/web).
CORS_ORIGINS=http://localhost:3415

# How a marked background becomes a URL the renderer can fetch.
#   data-uri     inline the bytes into the run's surface set (default). Makes a
#                run self-contained — preview, the pixel harness and an offline
#                reader all paint without reaching this service.
#   artifact-url point at the artifact content endpoint. Small artifacts, but
#                the renderer must reach and authenticate against the API.
#   s3           object storage. Production; not implemented yet.
# There is no "substitute a default image" mode on purpose: an unresolved asset
# is reported on the run and renders as nothing, because a background that
# renders as the WRONG picture is a bug that ships.
ASSET_PUBLISHER=data-uri
ASSET_BASE_URL=http://localhost:3000
ASSET_MAX_BYTES=4194304
