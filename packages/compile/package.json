{
  "name": "@fanos/compile",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic Figma IR -> DSL tree compiler. No model in the loop.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "fos-compile": "./dist/bin.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fanos/conform": "workspace:*",
    "@fanos/dsl": "workspace:*",
    "@fanos/figma-ir-extractor": "workspace:*",
    "@fanos/tokens": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": { "node": ">=22" }
}
