            "y": 46,
            "w": 363.3333435058594,
            "h": 44
           },
           "aspect": 8.2576,
           "aspectBucket": "ultrawide"
          },
          "fill": {
           "tokenRef": "text/main/medium",
           "unbound": false
          },
          "stroke": null,
          "radius": null,
          "effects": [],
          "opacity": 1,
          "clipsContent": false,
          "text": {
           "characters": "James Vince stroked 60 from 38 and Chris Jordan produced a late cameo with the bat as Southern Brave finally got their campaign up and running with victory under the lights at the Ageas Bowl. Liam Livingstone produced his first significant contribution of the Hundred with an unbeaten half-century and Adam Milne's 3 for 15 had seemingly set up Birmingham Phoenix for a narrow victory - only for Tom Helm to blink first against Jordan in the final set of five.\nAdvertisement",
           "styleRef": "body_sm/medium",
           "styleId": "S:fc5ba77ef2de9dcd79e8ecb5f9a60dae8e2e466f,18038:1029",
           "unbound": false,
           "fontSize": 12,
