           "lines": 2
          },
          "structuralSignature": "s2:1c57ca8701872a3a",
          "canonicalSignature": "c1:4201341993b0a54f",
          "repeatedSiblings": 2,
          "depth": 8,
          "childCount": 0,
          "children": []
         },
         {
          "id": "I1:4924;13448:62718",
          "name": "The longlist for The Hundred Auction have been revealed, with the likes of Joe Root, Davina Perrin, Nadine de Klerk and Shaheen Shah Afridi set to go under the hammer at Piccadilly Lights on 11 and 12 March.",
          "type": "TEXT",
          "layout": {
           "mode": "none",
           "gap": null,
           "padding": {
            "top": {
             "value": 0,
