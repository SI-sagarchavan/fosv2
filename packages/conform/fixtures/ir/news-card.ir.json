          "effects": [],
          "opacity": 1,
          "clipsContent": false,
          "text": {
           "characters": "Chris Jordan saw it through late on. Calm as a cucumber.",
           "styleRef": "body_md/bold",
           "styleId": "S:76adde1543c2e869fbc757d7fc8d94440be08499,18023:715",
           "unbound": false,
           "fontSize": 14,
