{
  "name": "@fanos/figma-ir-extractor",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin that walks a page frame and emits FanOS Frame IR + section screenshots",
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs && tsup",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.109.0",
    "@types/node": "^22",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "tsup": "^8.3.5"
  },
  "exports": {
    "./ir": {
      "types": "./dist/ir/index.d.ts",
      "import": "./dist/ir/index.js"
    }
  },
  "files": [
    "dist",
    "manifest.json"
  ]
}
